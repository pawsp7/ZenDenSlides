{
  "name": "zenden-slides",
  "version": "1.0.0",
  "private": true,
  "description": "Upload PowerPoint decks and play them through at a set pace.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c amber,cyan \"node server/index.js\" \"vite\"",
    "start": "NODE_ENV=production node server/index.js",
    "build": "vite build",
    "test": "node --test server/*.test.js",
    "seed-samples": "node scripts/generate-samples.js",
    "postinstall": "patch-package"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^5.1.0",
    "jszip": "^3.10.1",
    "multer": "^2.0.2",
    "pptx-browser": "^4.1.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "patch-package": "^8.0.1",
    "pptxgenjs": "^4.0.1",
    "vite": "^7.1.3"
  }
}
